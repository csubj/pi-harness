{
  "name": "@hcflabs/pi-cron",
  "version": "0.5.7",
  "description": "Run scheduled job prompts in new Pi sessions with per-job interval, Role, model, and thinking level.",
  "keywords": [
    "pi-package",
    "pi",
    "cron",
    "schedule",
    "automation"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "LICENSE",
    "extensions",
    "internal",
    "docs",
    "README.md",
    "CONTEXT.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/cron.ts internal/*.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0"
  },
  "dependencies": {
    "@hcflabs/pi-config-store": "^4.0.0",
    "@hcflabs/pi-subagent": "^27.2.0",
    "@hcflabs/pi-task-models": "^9.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/proper-lockfile": "^4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcflabs/pi-harness.git",
    "directory": "extensions/pi-cron"
  },
  "bugs": {
    "url": "https://github.com/hcflabs/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/cron.ts"
    ]
  }
}

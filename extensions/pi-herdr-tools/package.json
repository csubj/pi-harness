{
  "name": "@hcflabs/pi-herdr-tools",
  "version": "1.6.7",
  "description": "Clone, hand off, name, and finish Pi conversations in Herdr, with mergeable side questions.",
  "keywords": ["pi-package", "pi", "herdr", "session", "clone", "side-thread", "title"],
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "license": "MIT",
  "files": ["LICENSE", "extensions", "internal", "prompts", "docs", "README.md"],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/*.ts internal/*.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "typebox": "^1.3.15"
  },
  "dependencies": {
    "@hcflabs/pi-config-store": "^4.0.0",
    "@hcflabs/pi-herdr": "^0.5.0",
    "@hcflabs/pi-task-models": "^9.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcflabs/pi-harness.git",
    "directory": "extensions/pi-herdr-tools"
  },
  "bugs": { "url": "https://github.com/hcflabs/pi-harness/issues" },
  "publishConfig": { "access": "public" },
  "pi": { "extensions": ["./extensions/index.ts"], "prompts": ["./prompts"] }
}

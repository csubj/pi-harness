{
  "name": "@hcflabs/pi-prompt-creator",
  "version": "3.2.6",
  "description": "Turn current Pi conversation signals into user-approved prompt templates.",
  "keywords": [
    "pi-package",
    "pi",
    "prompt",
    "template"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "LICENSE",
    "extensions",
    "README.md",
    "CONTEXT.md",
    "docs/prompt-lifecycle.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --project tsconfig.json",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcflabs/pi-harness.git",
    "directory": "extensions/pi-prompt-creator"
  },
  "bugs": {
    "url": "https://github.com/hcflabs/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/prompt-creator.ts"
    ]
  },
  "dependencies": {
    "@hcflabs/pi-config-store": "^4.0.0",
    "@hcflabs/pi-subagent": "^22.0.0 || ^23.0.0 || ^24.0.0 || ^25.0.0 || ^26.0.0 || ^27.0.0 || ^28.0.0",
    "@hcflabs/pi-task-models": "^9.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0"
  }
}

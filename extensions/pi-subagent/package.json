{
  "name": "@hcflabs/pi-subagent",
  "version": "27.11.0",
  "description": "Delegate bounded direct work or durable checked isolated task graphs to Pi roles.",
  "keywords": [
    "pi-package",
    "pi",
    "subagent",
    "delegation"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "LICENSE",
    "dist",
    "extensions",
    "docs",
    "examples",
    "prompts",
    "example.png",
    "README.md",
    "CONTEXT.md",
    "skills"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "pretypecheck": "npm run build",
    "test": "npm run build && node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck src/*.ts extensions/*.ts test/*.test.ts",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "typebox": "^1.3.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcflabs/pi-harness.git",
    "directory": "extensions/pi-subagent"
  },
  "bugs": {
    "url": "https://github.com/hcflabs/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/subagent.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "image": "https://raw.githubusercontent.com/hcflabs/pi-harness/main/extensions/pi-subagent/example.png"
  },
  "dependencies": {
    "@hcflabs/pi-config-store": "^4.0.0",
    "@hcflabs/pi-herdr": "^0.5.0",
    "@hcflabs/pi-multi-codex": "^3.0.0",
    "@hcflabs/pi-process": "^0.2.0",
    "@hcflabs/pi-repo": "^0.1.0",
    "@hcflabs/pi-task-models": "^9.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/proper-lockfile": "^4.1.4"
  }
}
